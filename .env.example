# External PostgreSQL: use a real server hostname, not container localhost. URL-encode password special characters.
NEXUSAUTHORIZATION_DATABASE_URL='postgres://permission_center:CHANGE_ME@db.example.com:5432/permission_center?sslmode=require'
# Shell-compatible file: quote values, no spaces around '='. Never commit real secrets.

# Browser management authentication; false disables management authentication (development only).
NEXUSAUTHORIZATION_OIDC_ENABLED='true'
NEXUSAUTHORIZATION_OIDC_AUTHORITY='https://auth.example.com'
NEXUSAUTHORIZATION_OIDC_CLIENT_ID='permission.center'
NEXUSAUTHORIZATION_OIDC_CLIENT_SECRET='CHANGE_ME'
NEXUSAUTHORIZATION_OIDC_REDIRECT_URI='https://permissions.example.com/signin-oidc'
NEXUSAUTHORIZATION_OIDC_POST_LOGOUT_REDIRECT_URI='https://permissions.example.com/'
NEXUSAUTHORIZATION_OIDC_SCOPES='openid,profile,offline_access,permission.center.api'
NEXUSAUTHORIZATION_OIDC_AUDIENCE='permission.center.api'
NEXUSAUTHORIZATION_OIDC_SESSION_SECRET='CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32'
# Optional private route to the same identity provider:
# NEXUSAUTHORIZATION_OIDC_BACKCHANNEL_AUTHORITY='http://identity-provider:8080'

# Service resource catalog: nexusauth or local.
NEXUSAUTHORIZATION_SERVICE_RESOURCE_SOURCE='nexusauth'
NEXUSAUTHORIZATION_SERVICE_RESOURCE_NEXUSAUTH_BASE_URL='https://auth.example.com'
NEXUSAUTHORIZATION_SERVICE_RESOURCE_API_KEY='CHANGE_ME'

# Business services send this independent credential as Bearer to /v1/authorize.
NEXUSAUTHORIZATION_AUTHORIZATION_SERVICE_CREDENTIAL='CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32'

# API Token management admins (comma-separated NexusAuth user subject IDs).
NEXUSAUTHORIZATION_API_TOKEN_ADMIN_SUBJECTS='REPLACE_WITH_ADMIN_USER_SUBJECT'
# Independent key used by NexusAuth to call /internal/v1/api-tokens/authorize.
NEXUSAUTHORIZATION_API_TOKEN_INTERNAL_KEY='CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32'
NEXUSAUTHORIZATION_API_TOKEN_SERVICE_RESOURCE='nexusauthorization'

DASHBOARD_BIND_ADDR='0.0.0.0'
DASHBOARD_PORT='5274'
