# Local development only: management authentication disabled; ports bound to loopback.
POSTGRES_DB='permission_center'
POSTGRES_USER='postgres'
POSTGRES_PASSWORD='postgres'
POSTGRES_PORT='55434'
DASHBOARD_BIND_ADDR='127.0.0.1'
DASHBOARD_PORT='5274'
NEXUSAUTHORIZATION_OIDC_ENABLED='false'
NEXUSAUTHORIZATION_SERVICE_RESOURCE_SOURCE='local'
NEXUSAUTHORIZATION_AUTHORIZATION_SERVICE_CREDENTIAL='local-dev-service-credential'
# To test SSO, enable OIDC and configure authority, client secret and session secret.
# NEXUSAUTHORIZATION_OIDC_ENABLED='true'
# NEXUSAUTHORIZATION_OIDC_AUTHORITY='http://localhost:5100'
# NEXUSAUTHORIZATION_OIDC_BACKCHANNEL_AUTHORITY='http://host.docker.internal:5100'
# NEXUSAUTHORIZATION_OIDC_CLIENT_ID='permission.center'
# NEXUSAUTHORIZATION_OIDC_CLIENT_SECRET='CHANGE_ME'
# NEXUSAUTHORIZATION_OIDC_SESSION_SECRET='CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32'
# NEXUSAUTHORIZATION_OIDC_REDIRECT_URI='http://localhost:5274/signin-oidc'
# NEXUSAUTHORIZATION_OIDC_POST_LOGOUT_REDIRECT_URI='http://localhost:5274/'
