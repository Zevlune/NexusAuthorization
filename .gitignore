# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# .NET build output
**/bin/
**/obj/
**/TestResults/

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env
.env.dev
release/
/data/policies/
/data/oidc-session.key
/data/.oidc-session-*
/src/data/oidc-session.key
/src/data/.oidc-session-*

# Editor/IDE
# .idea/
# .vscode/
/demo/.idea/
*.sln.DotSettings.user

# React / Vite dashboard dependencies and generated artifacts
dashboard/node_modules/
dashboard/dist/
!dashboard/yarn.lock
dashboard/.vite/
dashboard/.eslintcache
dashboard/*.tsbuildinfo
dashboard/test-results/
dashboard/playwright-report/
dashboard/.env
dashboard/.env.*
!dashboard/.env.example
dashboard/.DS_Store
.env.deploy

# Local deployment configuration and runtime data
/.local/
/docker-compose.local.yml
