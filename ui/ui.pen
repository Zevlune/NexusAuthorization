                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "a8k3Cv",
                  "name": "API 接口规则2",
                  "fill": "$secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "2. 按模块、请求方法及路径搜索；筛选不清空已有选择。",
