                  "fill": "$secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "5. “仅看已选”与筛选叠加，隐藏项数量始终可见。",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 14,
